generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  PENDING
  ACTIVE
  AWAITING_VERIFICATION
  IN_DISPUTE
  SYNTHESIZING
  COMPLETED
  CANCELLED
}

enum SubtaskState {
  CREATED
  CLAIMED
  SUBMITTED
  AWAITING_VERIFICATION
  PENDING_RELEASE
  IN_DISPUTE
  VERIFIED
  REJECTED
  CANCELLED
}

model Task {
  id          String     @id @default(uuid())
  taskId      String     @unique
  creator     String
  description String
  budget      String
  status      TaskStatus @default(PENDING)
  solution    String?    @db.Text
  createdAt   DateTime   @default(now())
  subtasks    Subtask[]
}

model Subtask {
  id              String       @id @default(uuid())
  taskId          String
  subtaskId       String       @unique
  rangeLabel      String
  description     String
  reward          String
  bondAmount      String?      // MON bonded by the claiming worker
  leaseDuration   Int?         // dynamic lease in seconds
  worker          String?
  state           SubtaskState @default(CREATED)
  submissionHash  String?
  resultUrl       String?
  qualityScore    Int?
  aiRationale     String?      @db.Text
  aiFlags         String[]     @default([])
  disputeDeadline DateTime?
  createdAt       DateTime     @default(now())
  task            Task         @relation(fields: [taskId], references: [taskId])
  submissions     Submission[]
}

model Submission {
  id          String   @id @default(uuid())
  subtaskId   String
  worker      String
  storagePath String
  contentHash String
  createdAt   DateTime @default(now())
  subtask     Subtask  @relation(fields: [subtaskId], references: [subtaskId])
}

model Job {
  id        String   @id @default(uuid())
  type      String   // "VERIFY", "AGGREGATE"
  payload   Json
  status    String   // "PENDING", "PROCESSING", "COMPLETED", "FAILED"
  attempts  Int      @default(0)
  error     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkerProfile {
  address         String   @id
  successfulTasks Int      @default(0)
  failedTasks     Int      @default(0)
  reputationScore Int      @default(0)
  updatedAt       DateTime @updatedAt
}
