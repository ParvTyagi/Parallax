generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  PENDING
  ACTIVE
  AWAITING_VERIFICATION
  IN_DISPUTE
  SYNTHESIZING
  COMPLETED
  CANCELLED
}

enum SubtaskState {
  CREATED
  CLAIMED
  SUBMITTED
  AWAITING_VERIFICATION
  PENDING_RELEASE
  IN_DISPUTE
  VERIFIED
  REJECTED
  CANCELLED
}

model Task {
  id          String     @id @default(uuid())
  taskId      String     @unique
  creator     String
  description String
  budget      String
  status      TaskStatus @default(PENDING)
  solution    String?    @db.Text
  createdAt   DateTime   @default(now())

  // Structured spec, hydrated from the SpecDraft pinned at decompose time.
  objective       String?  @db.Text
  successCriteria String[] @default([])

  // Block the TaskCreated event was seen in — lets the UI show indexing lag.
  blockNumber Int?

  subtasks    Subtask[]

  @@index([creator])
}

model Subtask {
  id              String       @id @default(uuid())
  taskId          String
  subtaskId       String       @unique
  rangeLabel      String
  description     String
  reward          String
  bondAmount      String?      // MON bonded by the claiming worker
  leaseDuration   Int?         // dynamic lease in seconds
  worker          String?
  state           SubtaskState @default(CREATED)
  submissionHash  String?
  resultUrl       String?
  qualityScore    Int?
  aiRationale     String?      @db.Text
  aiFlags         String[]     @default([])
  disputeDeadline DateTime?
  createdAt       DateTime     @default(now())

  // Structured spec (hydrated from SpecDraft via the description CID).
  objective          String?  @db.Text
  contextNotes       String?  @db.Text
  acceptanceCriteria String[] @default([])
  deliverableFormat  String?
  skills             String[] @default([])
  estimatedMinutes   Int?

  // Per-criterion verdicts written back by the AI verifier:
  // [{ "criterion": string, "met": boolean, "note": string }]
  criteriaResults    Json?
  task            Task         @relation(fields: [taskId], references: [taskId])
  submissions     Submission[]

  @@index([taskId])
  @@index([worker])
  @@index([state])
}

model Submission {
  id          String   @id @default(uuid())
  subtaskId   String
  worker      String
  storagePath String
  contentHash String
  createdAt   DateTime @default(now())
  subtask     Subtask  @relation(fields: [subtaskId], references: [subtaskId])
}

model Job {
  id        String   @id @default(uuid())
  type      String   // "VERIFY", "AGGREGATE"
  payload   Json
  status    String   // "PENDING", "PROCESSING", "COMPLETED", "FAILED"
  attempts  Int      @default(0)
  error     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkerProfile {
  address         String   @id
  successfulTasks Int      @default(0)
  failedTasks     Int      @default(0)
  reputationScore Int      @default(0)
  updatedAt       DateTime @updatedAt
}

/// Structured subtask/master spec, written when the orchestrator decomposes a task
/// and keyed by the IPFS CID that later lands on-chain as the `description` field.
/// The chain listener looks the CID up to hydrate Task/Subtask columns, because the
/// contract only ever carries the CID itself.
model SpecDraft {
  cid                String   @id
  kind               String   // "MASTER" | "SUBTASK"
  title              String?
  objective          String?  @db.Text
  contextNotes       String?  @db.Text
  acceptanceCriteria String[] @default([])
  deliverableFormat  String?
  skills             String[] @default([])
  estimatedMinutes   Int?
  markdown           String?  @db.Text
  createdAt          DateTime @default(now())
}

/// Durable cursor for the chain event poller. Without this, a backend restart
/// (e.g. a Render free-tier cold start) silently drops every event emitted while
/// the process was down, and those tasks never appear in the UI.
model ChainCursor {
  id        String   @id            // contract address, lowercased
  lastBlock Int
  updatedAt DateTime @updatedAt
}

/// Metadata for an uploaded dataset attachment, keyed by its IPFS CID.
///
/// The bytes live on IPFS (or, without Pinata credentials, only in this process's
/// memory — hence `ephemeral`). The manifest is persisted here so a worker can
/// browse a large archive's contents without downloading it, and so the file
/// listing survives a backend restart.
model Attachment {
  cid              String   @id
  filename         String
  mimetype         String
  size             Int
  isArchive        Boolean  @default(false)
  entryCount       Int?
  uncompressedSize Int?
  entries          Json?
  truncated        Boolean  @default(false)
  ephemeral        Boolean  @default(false)
  createdAt        DateTime @default(now())
}

/// Durable copy of every text blob we pin, keyed by its CID.
///
/// Without this the only copy of a task/subtask description outside IPFS lived in
/// `mockIpfsStore`, a process-local Map. After a restart — or whenever a Pinata
/// upload failed and `pinToIPFS` fell back to a locally generated CID that was
/// never actually on IPFS — every gateway lookup missed and the UI rendered the
/// bare CID where the description should be.
model IpfsText {
  cid       String   @id
  content   String   @db.Text
  createdAt DateTime @default(now())
}
