# Parallax Environment Variables (Ethereum Configuration)

# ==========================================
# contracts/.env
# ==========================================
# For Ethereum Sepolia testnet:
# ETH_RPC_URL=https://rpc.sepolia.org
# For Localhost (Hardhat node):
# ETH_RPC_URL=http://127.0.0.1:8545
ETH_RPC_URL=https://rpc.sepolia.org
DEPLOYER_PRIVATE_KEY=
# Optional admin & treasury addresses (defaults to deployer if empty):
ADMIN_ADDRESS=
PLATFORM_TREASURY=

# ==========================================
# backend/.env
# ==========================================
# Ethereum RPC endpoint (Sepolia or local node)
ETH_RPC_URL=https://rpc.sepolia.org
TASKMANAGER_ADDRESS=
ESCROW_ADDRESS=
ORCHESTRATOR_PRIVATE_KEY=
GEMINI_API_KEY=
# General generation and a separate fast verifier (Gemini v1beta REST API).
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_VERIFY_MODEL=gemini-3.1-flash-lite
GEMINI_VERIFY_FALLBACK_MODEL=gemini-2.5-flash
# PostgreSQL database URL (e.g., local PostgreSQL or cloud Neon/Supabase)
# postgresql://postgres:postgres@localhost:5432/parallax?schema=public
DATABASE_URL=
# Optional: only needed to read older submissions stored in Supabase.
# New worker submissions use the Pinata/IPFS configuration below.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Block the TaskManager was deployed at. The event indexer backfills from here.
CHAIN_START_BLOCK=
CHAIN_POLL_INTERVAL_MS=5000
CHAIN_MAX_BLOCK_SPAN=99
ORCHESTRATOR_TX_TIMEOUT_MS=120000
MAX_UPLOAD_MB=100

# Optional: IPFS Pinata credentials
IPFS_GATEWAY=
PINATA_JWT=
PINATA_API_KEY=
PINATA_SECRET_API_KEY=

# ==========================================
# frontend/.env
# ==========================================
# 0xaa36a7 = Sepolia (11155111) | 0x7a69 = Localhost (31337)
VITE_ETH_CHAIN_ID=0xaa36a7
VITE_BLOCK_EXPLORER_URL=https://sepolia.etherscan.io
VITE_TASKMANAGER_ADDRESS=
VITE_API_URL=http://localhost:3000
