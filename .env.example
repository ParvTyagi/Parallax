# Parallax Environment Variables

# ==========================================
# contracts/.env
# ==========================================
MONAD_RPC_URL=
MONAD_CHAIN_ID=
DEPLOYER_PRIVATE_KEY=

# ==========================================
# backend/.env
# ==========================================
MONAD_RPC_URL=
TASKMANAGER_ADDRESS=
ESCROW_ADDRESS=
ORCHESTRATOR_PRIVATE_KEY=
GEMINI_API_KEY=
DATABASE_URL=

# Block the TaskManager was deployed at. The event indexer keeps a durable cursor
# in the DB; on a brand-new database it backfills from here so tasks created while
# the backend was down (or before it ever ran) are still picked up. Leave blank to
# start ~200 blocks back instead.
CHAIN_START_BLOCK=
# Optional indexer tuning.
CHAIN_POLL_INTERVAL_MS=5000
# Monad public RPC rejects eth_getLogs ranges wider than 100 blocks.
CHAIN_MAX_BLOCK_SPAN=99
# How long to wait for an orchestrator transaction to mine before giving up.
# Bounds the shared transaction queue so one stalled tx cannot block payouts.
ORCHESTRATOR_TX_TIMEOUT_MS=120000
# Max size for a single dataset upload, in MB (uploads are buffered in memory).
# The frontend zips multi-file / large selections before upload, so this is the
# size of the compressed archive.
MAX_UPLOAD_MB=100
# Optional: preferred IPFS gateway + Pinata credentials for real pinning.
# Without these, attachments live only in backend memory and are lost on restart.
IPFS_GATEWAY=
PINATA_JWT=
PINATA_API_KEY=
PINATA_SECRET_API_KEY=

# ==========================================
# frontend/.env
# ==========================================
VITE_MONAD_CHAIN_ID=
VITE_TASKMANAGER_ADDRESS=
VITE_API_URL=

